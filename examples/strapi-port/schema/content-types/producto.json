{
  "kind": "collectionType",
  "singularName": "producto",
  "pluralName": "productos",
  "displayName": "Producto",
  "options": { "draftAndPublish": true },
  "attributes": {
    "nombre": { "type": "string", "required": true, "maxLength": 200 },
    "slug": { "type": "uid", "targetField": "nombre", "required": true },
    "descripcion": { "type": "text" },
    "precio": { "type": "decimal", "min": 0 },
    "a_la_venta": { "type": "boolean", "default": true },
    "reservable": { "type": "boolean", "default": false }
  }
}
